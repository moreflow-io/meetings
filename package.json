{
  "name": "@moreflow/meetings",
  "version": "0.2.1",
  "description": "Headless browser protocol helpers for Moreflow public meeting booking.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moreflow-io/meetings.git"
  },
  "homepage": "https://github.com/moreflow-io/meetings#readme",
  "bugs": {
    "url": "https://github.com/moreflow-io/meetings/issues"
  },
  "keywords": [
    "moreflow",
    "meetings",
    "booking",
    "headless",
    "browser"
  ],
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "jsdelivr": "./dist/browser.js",
  "unpkg": "./dist/browser.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": "./dist/browser.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && esbuild src/index.ts --bundle --external:@moreflow/tracking --format=esm --minify --outfile=dist/index.js && esbuild src/index.ts --bundle --format=iife --global-name=MoreflowMeetings --target=es2019 --minify --outfile=dist/browser.js && tsc --singleThreaded -p tsconfig.build.json",
    "typecheck": "tsc --singleThreaded --noEmit",
    "test": "vitest run",
    "prepublishOnly": "bun run build && bun run test"
  },
  "dependencies": {
    "@moreflow/tracking": "^0.2.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "19.2.13",
    "esbuild": "^0.25.12",
    "jsdom": "^29.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
